# Copier vers docker/.env.pi et renseigner les secrets.
# Ne jamais versionner le fichier .env.pi.

POSTGRES_PASSWORD=REMPLACER_PAR_UN_SECRET_LONG

Authentication__Google__ClientId=REMPLACER
Authentication__Google__ClientSecret=REMPLACER

Pexels__ApiKey=REMPLACER

# Pinterest (facultatif)
Pinterest__Enabled=false
Pinterest__AppId=
Pinterest__AppSecret=

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=REMPLACER

# Épingler le même SHA pour les deux images en production.
# APP_IMAGE=ghcr.io/paulbertelli/reference-dessin:SHA_DU_COMMIT
# MIGRATIONS_IMAGE=ghcr.io/paulbertelli/reference-dessin-migrations:SHA_DU_COMMIT
